# NovaStart 环境变量模板（复制为 backend/.env 后按需修改）

# 数据库：本地绿色版 PostgreSQL（trust 认证，无密码）
DATABASE_URL=postgresql+psycopg://postgres@127.0.0.1:5432/novastart

# LLM 可插拔客户端：mock | deepseek | openai | custom
LLM_PROVIDER=mock
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat

# 时间模式：normal 使用真实服务端时间
CLOCK_MODE=normal
